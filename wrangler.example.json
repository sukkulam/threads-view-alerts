{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threads-view-alerts",
  "account_id": "REPLACE_WITH_YOUR_ACCOUNT_ID",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "threads-view-alerts-db", "database_id": "REPLACE_WITH_YOUR_DATABASE_ID" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" },
  "observability": { "enabled": true }
}
